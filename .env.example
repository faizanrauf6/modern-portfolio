# Server-only — never prefix with NEXT_PUBLIC.

# Leave empty for local preview. Set the final public URL when available.
SITE_URL=""

# Powers the AI terminal widget (/api/chat). Without it the terminal replies
# with an "AI is offline" message instead of live answers.
OPENAI_API_KEY=""
# Optional — defaults to gpt-6-luna, with reasoning disabled for short Q&A.
OPENAI_MODEL="gpt-6-luna"

# Optional GraphQL access for the contribution graph. Without a token,
# the public GitHub calendar is refreshed daily. A dated snapshot is the fallback.
GITHUB_TOKEN=""
